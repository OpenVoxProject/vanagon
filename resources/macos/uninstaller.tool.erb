#!/bin/bash

# Uninstaller for <%= @name %>, generated by vanagon.
#
# Removal is driven by the installer receipt rather than by a fixed list of
# directories, so directories shared with other packages (for example
# /opt/puppetlabs/bin, which is used by both openvox-agent and openbolt) are
# only removed when nothing else owns them.

export LC_ALL=C

pkg_id="<%= @identifier %>.<%= @name %>"

# Top-level directories that belong to the operating system. They are never
# removed, even when the receipt lists them and they end up empty.
protected_dirs=" Applications Library System Users bin etc opt private private/etc private/var sbin usr usr/local var "

is_protected() {
  case "${protected_dirs}" in
    *" ${1} "*) return 0 ;;
    *) return 1 ;;
  esac
}

<%- if has_services? -%>
<%- get_services.each do |service| -%>
echo "Unloading service <%= service.name %>..."
/bin/launchctl unload <%= service.service_file %>
echo "OK"
echo "Removing service file <%= service.service_file %>..."
/bin/rm -f <%= service.service_file %>
echo "OK"
<%- end -%>
<%- end -%>

pkg_info=$(/usr/sbin/pkgutil --pkg-info "${pkg_id}" 2>/dev/null)
if [ -z "${pkg_info}" ]; then
  echo "No installer receipt found for ${pkg_id}; nothing to remove." >&2
  exit 1
fi

volume=$(printf '%s\n' "${pkg_info}" | /usr/bin/sed -n 's/^volume: //p')
volume="${volume:-/}"
location=$(printf '%s\n' "${pkg_info}" | /usr/bin/sed -n 's/^location: //p')
root="${volume%/}/${location#/}"
root="${root%/}"

workdir=$(/usr/bin/mktemp -d -t "${pkg_id}-uninstall")
trap '/bin/rm -rf "${workdir}"' EXIT

/usr/sbin/pkgutil --volume "${volume}" --files "${pkg_id}" | /usr/bin/sort > "${workdir}/entries"
/usr/sbin/pkgutil --volume "${volume}" --only-dirs --files "${pkg_id}" | /usr/bin/sort > "${workdir}/directories"

echo "Removing files installed by ${pkg_id}..."
/usr/bin/comm -23 "${workdir}/entries" "${workdir}/directories" |
while IFS= read -r entry; do
  /bin/rm -f "${root}/${entry}"
done
echo "OK"

# Directories declared by the project are removed along with anything written
# to them after installation (logs, caches, configuration), unless another
# installed package also claims them.
remove_unshared_directory() {
  entry="${1#/}"
  dir="${root}/${entry}"
  [ -d "${dir}" ] || return 0
  if is_protected "${entry}"; then
    echo "Keeping ${dir}: it belongs to the operating system"
    return 0
  fi
  owners=$(/usr/sbin/pkgutil --volume "${volume}" --file-info "${dir}" 2>/dev/null |
    /usr/bin/sed -n 's/^pkgid: //p' | /usr/bin/grep -vx "${pkg_id}")
  if [ -n "${owners}" ]; then
    echo "Keeping ${dir}: it is also used by $(printf '%s' "${owners}" | /usr/bin/tr '\n' ' ')"
    return 0
  fi
  /bin/rm -Rf "${dir}"
}

echo "Removing directories owned by ${pkg_id}..."
<%- get_directories.map(&:path).each do |dir| -%>
remove_unshared_directory '<%= dir %>'
<%- end -%>
echo "OK"

echo "Removing empty directories..."
/usr/bin/sort -r "${workdir}/directories" |
while IFS= read -r entry; do
  is_protected "${entry}" && continue
  /bin/rmdir "${root}/${entry}" 2>/dev/null
done
echo "OK"

echo "Removing identifier: ${pkg_id}..."
/usr/sbin/pkgutil --volume "${volume}" --forget "${pkg_id}"
echo "OK"
